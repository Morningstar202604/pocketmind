# ⚠ 已废弃（legacy）：本文件属于旧版 goose 架构。新版 agentd 无需设置任何环境变量，
#   LLM 配置在网页「设置」面板里填写。请使用：bash termux/start.sh
#
# 复制本文件为 termux.env 并按需修改，然后 source 使用。
# 示例：
#   cp termux.env my.env
#   vi my.env
#   source my.env
#
# 提示：goose 的 declarative provider 通过 api_key_env 读取 API key，
# 该变量名需与 config/provider.json 的 api_key_env 字段保持一致（默认 LLM_API_KEY）。
# base_url 直接写在 provider.json 里；如需运行时覆盖，可用 OPENAI_HOST 环境变量
# （goose 内置 openai 引擎支持，custom provider 则建议直接改 provider.json）。
#
# 注意：LLM_API_KEY 由你自行填入，请勿将真实 key 提交到 git 仓库。
# 本文件为模板，.env 已被 git 忽略。
export GOOSE_PROVIDER="custom_llm"
export GOOSE_MODEL="agnes-3.0-flash"
export LLM_API_KEY=""

# 可选：禁用遥测（Android 上建议开启）
export GOOSE_DISABLE_TELEMETRY=1
# 可选：禁用 D-Bus keyring（Android 上没有 D-Bus）
export GOOSE_DISABLE_KEYRING=1
