#!/bin/bash
# ⚠ 已废弃（legacy）：旧版 goose 架构的 termux-api 桥接。新版 agentd 已内置
#   termux-api 调用（agentd/tools/phone.py，纯 Python，无 jq 依赖），无需本脚本。
#   请使用：bash termux/start.sh
#
# termux-api bridge for the Android agent distribution.
# Each function wraps a termux-api call and prints JSON so the agent can call it via shell.

json() {
  echo "$1"
}

termux_notify() {
  local title="${1:-}"
  local message="${2:-}"
  if command -v termux-notification >/dev/null 2>&1; then
    termux-notification --title "$title" --content "$message"
    json "{\"ok\":true}"
  else
    json "{\"ok\":false,\"error\":\"termux-notification not available; run: pkg install termux-api && termux-setup-storage\"}"
  fi
}

termux_clipboard_get() {
  if command -v termux-clipboard-get >/dev/null 2>&1; then
    local content
    content=$(termux-clipboard-get)
    json "{\"ok\":true,\"content\":$(echo "$content" | jq -Rs .)}"
  else
    json "{\"ok\":false,\"error\":\"termux-clipboard-get not available\"}"
  fi
}

termux_clipboard_set() {
  local content="${1:-}"
  if command -v termux-clipboard-set >/dev/null 2>&1; then
    echo -n "$content" | termux-clipboard-set
    json "{\"ok\":true}"
  else
    json "{\"ok\":false,\"error\":\"termux-clipboard-set not available\"}"
  fi
}

termux_location() {
  if command -v termux-location >/dev/null 2>&1; then
    termux-location --json 2>/dev/null | jq -c '{ok:true, latitude, longitude, accuracy, time}'
  else
    json "{\"ok\":false,\"error\":\"termux-location not available\"}"
  fi
}

termux_battery_status() {
  if command -v termux-battery-status >/dev/null 2>&1; then
    termux-battery-status --json | jq -c '{ok:true, status, percentage, plugged, technology, temperature, voltage}'
  else
    json "{\"ok\":false,\"error\":\"termux-battery-status not available\"}"
  fi
}

termux_tts_speak() {
  local text="${1:-}"
  if command -v termux-tts-speak >/dev/null 2>&1; then
    termux-tts-speak "$text"
    json "{\"ok\":true}"
  else
    json "{\"ok\":false,\"error\":\"termux-tts-speak not available\"}"
  fi
}

usage() {
  cat <<'EOF'
termux-bridge command:
  termux-bridge notify <title> <message>
  termux-bridge clipboard-get
  termux-bridge clipboard-set <content>
  termux-bridge location
  termux-bridge battery
  termux-bridge tts-speak <text>
EOF
}

case "${1:-}" in
  notify)
    shift
    termux_notify "$@"
    ;;
  clipboard-get)
    termux_clipboard_get
    ;;
  clipboard-set)
    shift
    termux_clipboard_set "$*"
    ;;
  location)
    termux_location
    ;;
  battery)
    termux_battery_status
    ;;
  tts-speak)
    shift
    termux_tts_speak "$*"
    ;;
  *)
    usage
    ;;
esac
